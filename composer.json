{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "pushery/http-api-for-laravel",
  "description": "The IETF HTTP API standards for Laravel: Idempotency-Key replays that compare the request body, and RFC 9457 problem details for every API error.",
  "keywords": [
    "laravel",
    "http",
    "api",
    "idempotency",
    "idempotency-key",
    "rfc9457",
    "problem-details"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pushery"
    }
  ],
  "type": "library",
  "homepage": "https://github.com/pushery/http-api-for-laravel",
  "support": {
    "issues": "https://github.com/pushery/http-api-for-laravel/issues",
    "source": "https://github.com/pushery/http-api-for-laravel",
    "docs": "https://docs.pushery.com/http-api-for-laravel/",
    "security": "https://github.com/pushery/http-api-for-laravel/security/policy"
  },
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "illuminate/auth": "^13.0",
    "illuminate/collections": "^13.0",
    "illuminate/container": "^13.0",
    "illuminate/contracts": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/support": "^13.0",
    "illuminate/validation": "^13.0",
    "symfony/http-foundation": "^7.0 || ^8.0",
    "symfony/http-kernel": "^7.0 || ^8.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.9.3",
    "laravel/ai": "^1.0",
    "laravel/boost": "^2.9",
    "laravel/mcp": "^1.0",
    "laravel/pao": "^1.1",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^11.2",
    "pestphp/pest": "^5.2.1",
    "pestphp/pest-plugin-agent": "^5.0",
    "pestphp/pest-plugin-browser": "^5.2",
    "pestphp/pest-plugin-evals": "^5.1",
    "pestphp/pest-plugin-laravel": "^5.0",
    "pestphp/pest-plugin-phpstan": "^5.0",
    "pestphp/pest-plugin-type-coverage": "^5.0",
    "phpstan/phpstan": "^2.3.0",
    "pushery/sqlens-for-laravel": "^0.33.1",
    "rector/rector": "^2.7.0",
    "spaze/phpstan-disallowed-calls": "^4.12",
    "symfony/yaml": "^7.4.17 || ^8.1.5"
  },
  "autoload": {
    "psr-4": {
      "Pushery\\HttpApi\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "process-timeout": 0,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pushery\\HttpApi\\HttpApiServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
